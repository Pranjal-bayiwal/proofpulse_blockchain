# Copy to backend/.env and edit. Every value has a safe local default except the secrets.

# ---- Security (CHANGE ALL THREE before any real deployment) ----
SECRET_KEY=change-me-to-a-long-random-string
PSEUDONYM_SALT=change-me-to-another-random-string
ADMIN_PASSWORD=Admin@12345!
# Optional: a Fernet key for encrypting stored files. Leave empty to auto-generate backend/data/fernet.key
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

# ---- Web ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:5173     # encoded into QR codes and certificates

# ---- Database (SQLite by default; PostgreSQL works too) ----
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/proofpulse

# ---- Blockchain ----
# embedded : in-process EVM, zero setup, persisted through backend/data/chain_journal.jsonl  (default)
# rpc      : Hardhat node, Ganache, or a public testnet such as Sepolia
BLOCKCHAIN_MODE=embedded
# RPC_URL=http://127.0.0.1:8545
# CHAIN_PRIVATE_KEY=0x...        # required for public testnets (account must hold test ETH)
# CONTRACT_ADDRESS=0x...         # reuse an already deployed contract; empty = deploy on first start
